---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Privacy Policy | AC Repair Wake Forest NC" description="Privacy policy for acrepairinwakeforestnc.com.">
  <section class="page-hero">
    <div class="container">
      <h1>Privacy Policy</h1>
      <p>How we handle information on this website.</p>
    </div>
  </section>
  <section class="content-section">
    <div class="container" style="max-width:800px">
      <p>This website (acrepairinwakeforestnc.com) is a static informational site. We do not collect personal information through forms on this site unless you contact us by phone.</p>
      <h2>Phone Calls</h2>
      <p>When you call us, we use the information you provide to schedule service and communicate about your appointment. We do not sell or share your contact information with third parties for marketing.</p>
      <h2>Analytics &amp; Cookies</h2>
      <p>This site may use standard hosting analytics provided by Cloudflare. No third-party advertising trackers are intentionally embedded.</p>
      <h2>Contact</h2>
      <p>Questions about this policy: call (919) 555-0199.</p>
      <p>Last updated: October 2026</p>
    </div>
  </section>
</Layout>